<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/student_name_hint"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etStudentSurname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/student_surname_hint"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etStudentAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/student_age_hint"
        android:inputType="number" />

    <EditText
        android:id="@+id/etGroupId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/group_id_hint"
        android:inputType="number" />

    <Button
        android:id="@+id/btnSaveStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_student_text" />
</LinearLayout>
